# ============================================================
# Project Management System — Root Git Ignore
# ============================================================

node_modules

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
build/
**/build/
out/
**/out/

# Vite and framework caches
.vite/
**/.vite/
.cache/
**/.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage and test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# Runtime and process files
pids/
*.pid
*.pid.lock

# Local databases and database artifacts
*.sqlite
*.sqlite3
*.db

# Prisma generated client (generated by Prisma; do not commit local generated output)
# Keep schema.prisma and migrations tracked if present.
server/node_modules/.prisma/
server/node_modules/@prisma/client/

# Inngest and temporary files
.inngest/
tmp/
temp/

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Editor and IDE settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Local environment and tooling
.vercel/
.netlify/
.turbo/

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Package manager / debug artifacts
.npm/
.eslintcache

# Optional local uploads and generated files
uploads/
storage/
